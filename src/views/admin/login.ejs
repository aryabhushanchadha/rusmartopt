<!doctype html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
<%- include('../partials/styles') %>
<style>
.login-box{min-height:100vh;display:grid;place-items:center;padding:24px}
.login-card{width:min(360px,100%);background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:28px}
.login-card h1{font-size:18px;margin-bottom:18px}
.login-card label{font-size:12px;font-weight:600;color:var(--muted);display:block;margin:12px 0 6px}
.login-card input{width:100%;border:1px solid var(--line);background:var(--ground);border-radius:8px;padding:10px 12px;font-size:14px;color:var(--ink);outline:none}
.login-card input:focus{border-color:var(--accent)}
.login-card .err{margin-top:14px;font-size:13px;color:#D0483C}
</style>
</head>
<body>
<div class="login-box">
  <div class="login-card">
    <h1>Метрики RuSmartOpt — вход</h1>
    <form method="POST" action="/admin/login">
      <label for="email">Эл. почта</label>
      <input id="email" name="email" type="email" required autocomplete="username">
      <label for="password">Пароль</label>
      <input id="password" name="password" type="password" required autocomplete="current-password">
      <button class="btn" style="width:100%;margin-top:18px" type="submit">Войти</button>
    </form>
    <% if (error) { %><div class="err"><%= error %></div><% } %>
  </div>
</div>
</body>
</html>
